# ==========================================
# DARKDEKU225 AI VIDEO - CONFIGURATION
# ==========================================
# Copiez ce fichier en ".env" et remplissez les valeurs.
# Ne JAMAIS committer le fichier ".env" réel.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# ID Telegram numérique de l'administrateur unique
ADMIN_ID=1299831974

# Canal Telegram obligatoire (username sans @, utilisé pour l'API getChatMember)
REQUIRED_CHANNEL_USERNAME=Deku225_Master
# Lien affiché à l'utilisateur pour rejoindre le canal
REQUIRED_CHANNEL_LINK=https://t.me/Deku225_Master

# --- Agnes AI ---
# Nom du modèle vidéo Agnes actif. Isolé ici pour pouvoir migrer facilement
# vers un nouveau modèle (ex: agnes-video-v2.5) sans toucher au code.
AGNES_MODEL=agnes-video-v2.0
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_CREATE_PATH=/v1/videos
AGNES_RESULT_PATH=/agnesapi

# Les clés API Agnes elles-mêmes NE SONT PAS mises ici : elles sont ajoutées
# et stockées de façon chiffrée dans SQLite depuis le panel admin Telegram
# (menu 🔑 API > ➕ Ajouter une clé).

# Clé de chiffrement locale utilisée pour chiffrer les clés Agnes stockées en base.
# Générez une valeur aléatoire forte, par ex: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Comportement du bot ---
# Cooldown individuel entre deux générations, en secondes
GENERATION_COOLDOWN_SECONDS=20

# Intervalle de polling Agnes en millisecondes (respecter les limites de l'API)
AGNES_POLL_INTERVAL_MS=4000
# Nombre maximum de tentatives de polling avant d'abandonner une tâche
AGNES_POLL_MAX_ATTEMPTS=150

# --- Base de données ---
DATABASE_PATH=./data/bot.sqlite

# --- Dossiers temporaires (images/vidéos téléchargées) ---
TEMP_DIR=./temp
